{
  // name は Cloudflare の Worker 名と同じにする（〇〇.workers.dev の〇〇の部分）
  "name": "kentonagaya-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // 管理画面で設定した値を、デプロイのたびに消さない
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/contact", "/contact/", "/en-contact", "/en-contact/"]
  },
  // お問い合わせメールの送信。届け先などは Cloudflare の管理画面で設定する（ここには書かない）
  "send_email": [{ "name": "EMAIL" }]
}
